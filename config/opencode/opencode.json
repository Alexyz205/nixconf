{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "lsp": {
    "nixd": { "disabled": true },
    "pyright": { "disabled": true },
    "nil": {
      "command": ["nil"],
      "extensions": [".nix"]
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "clangd": {
      "command": ["clangd"],
      "extensions": [".c", ".h", ".cpp", ".hpp", ".cc", ".cxx", ".hxx", ".ino"]
    },
    "lua-ls": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server"],
      "extensions": [".yaml", ".yml"]
    },
    "marksman": {
      "command": ["marksman"],
      "extensions": [".md", ".mdx"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "steps": 20
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "steps": 30
    },
    "compaction": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "title": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/repos/work/**", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "gh", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "glab", "effect": "deny" },
    { "action": "shell", "resource": "glab *", "effect": "deny" },
    { "action": "shell", "resource": "curl * | sh", "effect": "deny" },
    { "action": "shell", "resource": "wget * | sh", "effect": "deny" },
    { "action": "shell", "resource": "sudo", "effect": "ask" },
    { "action": "shell", "resource": "shutdown", "effect": "deny" },
    { "action": "shell", "resource": "reboot", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R 777 *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -f *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "sudo rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sops*", "effect": "ask" },
    { "action": "shell", "resource": "age*", "effect": "ask" },
    { "action": "shell", "resource": "gpg*", "effect": "ask" },
    { "action": "shell", "resource": "ssh-keygen*", "effect": "ask" },
    { "action": "shell", "resource": "openssl*", "effect": "ask" },
    { "action": "shell", "resource": "security*", "effect": "ask" },
    { "action": "shell", "resource": "cosign*", "effect": "ask" },
    { "action": "shell", "resource": "nix store sign*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune -a", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get secret*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe secret*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl apply *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete pod*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete pvc*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete pv*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete secret*", "effect": "ask" }
  ],
  "experimental": {
    "todo": true
  },
  "compaction": {
    "auto": true,
    "buffer": 8000
  },
  "instructions": [
    "~/repos/personal/nixconf/README.md",
    "~/.config/opencode/AGENTS.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".terraform/**",
      "vendor/**",
      "__pycache__/**",
      ".venv/**",
      "dist/**",
      "build/**",
      ".cache/**",
      "coverage/**"
    ]
  },
  "commands": {
    "review": {
      "description": "Code review the current changes",
      "template": "Review the staged and unstaged git changes. Focus on: security issues, error handling, best practices violations, and potential bugs. Provide actionable feedback."
    },
    "tf-plan": {
      "description": "Run and analyze terraform plan",
      "template": "Run `terraform plan` in the current directory, analyze the output for: resource changes, potential issues, cost implications, and security concerns. Summarize findings."
    },
    "test": {
      "description": "Run tests and fix failures",
      "template": "Identify the test framework in use, run the test suite, analyze any failures, and fix them. Run tests again to confirm fixes. $ARGUMENTS"
    },
    "explain": {
      "description": "Explain a file or concept in detail",
      "template": "Provide a thorough explanation of $ARGUMENTS including: purpose, how it works, key design decisions, and potential improvements."
    },
    "security": {
      "description": "Security audit of the codebase",
      "template": "Perform a security audit: check for hardcoded secrets, insecure permissions, vulnerable dependencies, and configuration issues. Provide severity-ranked findings."
    },
    "refactor": {
      "description": "Refactor code following best practices",
      "template": "Analyze $ARGUMENTS for code quality issues and refactor following best practices. Explain each change and why it improves the code."
    },
    "optimize": {
      "description": "Analyze code for performance, security, and issues",
      "template": "Analyze $ARGUMENTS comprehensively across three dimensions:\n\n**Performance**: Algorithmic complexity, memory usage, I/O patterns, caching opportunities, unnecessary allocations, N+1 queries, framework-specific optimizations.\n\n**Security**: Input validation, authentication/authorization gaps, data exposure, injection vectors, dependency vulnerabilities, insecure defaults, secrets handling.\n\n**Potential Issues**: Error handling gaps, edge cases, race conditions, scalability bottlenecks, maintainability concerns, missing observability.\n\nFor each finding, provide: severity (critical/high/medium/low), location (file:line), description, and a concrete fix. Rank findings by severity. End with a summary table."
    },
    "clean": {
      "description": "Clean up code: formatting, imports, debug removal, linting",
      "template": "Run a cleanup pipeline on $ARGUMENTS in this order:\n\n1. **Debug removal** - Remove console.log, print(), debugger statements, TODO/FIXME comments that are resolved, commented-out code blocks\n2. **Import optimization** - Sort imports, remove unused imports, group by stdlib/external/internal\n3. **Formatting** - Apply project formatter (prettier, black, gofmt, etc.) or consistent style\n4. **Lint fixes** - Fix linter warnings (eslint, pylint, shellcheck, etc.)\n5. **Type safety** - Fix type errors if TypeScript/mypy/type hints are in use\n\nAfter cleanup, run the project linter/formatter to verify. Show a summary of changes made in each category."
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      }
    }
  }
}
