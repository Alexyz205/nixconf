{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "diffs": {
    "view": "auto"
  },
  "mouse": true,
  "animations": true,
  "session": {
    "tps": true,
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto"
  },
  "terminal": {
    "title": true
  },
  "scroll": {
    "acceleration": true
  },
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "keybinds": {
    "app.toggle.file_context": "<leader>f"
  }
}
