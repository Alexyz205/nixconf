# =========================================================
# Nix / flake artifacts
# =========================================================
/result
/result-*
/.direnv/

# devenv: ephemeral environment store (NOT the lockfile — commit devenv.lock)
/.devenv/
/.pre-commit-config.yaml

# Script tmp files
.sha256*

# =========================================================
# Secrets — never commit plaintext keys/creds.
# Encrypted values live in secrets/ (managed by sops).
# =========================================================
age-keys.txt
*.age

# SSH private keys / FIDO2 key handles. Only *.pub files belong in the repo.
config/ssh/id_*
!config/ssh/id_*.pub
config/ssh/*.pem
config/ssh/*.key
*.gpg

# =========================================================
# Language / dependency artifacts
# =========================================================
node_modules/
*.o
*.a
.ruff_cache/

# =========================================================
# OS / editor cruft
# =========================================================
core
core.*
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
